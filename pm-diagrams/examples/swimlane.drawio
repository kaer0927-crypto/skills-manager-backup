<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-06-29T00:00:00.000Z" agent="pm-diagrams-skill" version="24.0.0">
  <diagram name="O2O订单履约-泳道" id="swimlane-o2o">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 外层大泳道：流程名（4 个子泳道无缝嵌在这一个大泳道里） -->
        <mxCell id="lane_outer" value="外卖订单履约" style="swimlane;html=1;childLayout=stackLayout;resizeParent=1;resizeParentMax=0;startSize=40;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1100" height="800" as="geometry" />
        </mxCell>

        <!-- 内层 4 个子泳道：紧密相接无缝衔接，底部与外层泳道对齐 -->
        <mxCell id="lane_user" value="用户" style="swimlane;html=1;startSize=30;" vertex="1" parent="lane_outer">
          <mxGeometry x="0" y="40" width="275" height="760" as="geometry" />
        </mxCell>
        <mxCell id="lane_merchant" value="商家" style="swimlane;html=1;startSize=30;" vertex="1" parent="lane_outer">
          <mxGeometry x="275" y="40" width="275" height="760" as="geometry" />
        </mxCell>
        <mxCell id="lane_backend" value="平台后端" style="swimlane;html=1;startSize=30;" vertex="1" parent="lane_outer">
          <mxGeometry x="550" y="40" width="275" height="760" as="geometry" />
        </mxCell>
        <mxCell id="lane_rider" value="骑手" style="swimlane;html=1;startSize=30;" vertex="1" parent="lane_outer">
          <mxGeometry x="825" y="40" width="275" height="760" as="geometry" />
        </mxCell>

        <!-- 用户泳道步骤（节点默认 120x60，子泳道宽 275 居中 x=78；跨泳道节点 y 对齐） -->
        <mxCell id="step_user_1" value="1. 下单付款" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;" vertex="1" parent="lane_user">
          <mxGeometry x="78" y="60" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="step_user_2" value="7. 完成评价" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;" vertex="1" parent="lane_user">
          <mxGeometry x="78" y="200" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- 商家泳道步骤 -->
        <mxCell id="step_merch_1" value="2. 接单备餐" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;" vertex="1" parent="lane_merchant">
          <mxGeometry x="78" y="60" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- 平台后端泳道步骤 -->
        <mxCell id="step_back_1" value="3. 通知派单" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;" vertex="1" parent="lane_backend">
          <mxGeometry x="78" y="60" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="step_back_2" value="6. 推送完成" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;" vertex="1" parent="lane_backend">
          <mxGeometry x="78" y="200" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- 骑手泳道步骤 -->
        <mxCell id="step_rider_1" value="4. 取餐送达" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;" vertex="1" parent="lane_rider">
          <mxGeometry x="78" y="60" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="step_rider_2" value="5. 回传状态" style="rounded=1;whiteSpace=wrap;html=1;arcSize=0;" vertex="1" parent="lane_rider">
          <mxGeometry x="78" y="200" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- 同泳道内边：parent 指向所在子泳道；正交+圆角风格 -->
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;" edge="1" parent="lane_rider" source="step_rider_1" target="step_rider_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 跨子泳道边：parent 指向外层大泳道 lane_outer；正交+圆角风格 -->
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;" edge="1" parent="lane_outer" source="step_user_1" target="step_merch_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;" edge="1" parent="lane_outer" source="step_merch_1" target="step_back_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;" edge="1" parent="lane_outer" source="step_back_1" target="step_rider_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;" edge="1" parent="lane_outer" source="step_rider_2" target="step_back_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;" edge="1" parent="lane_outer" source="step_back_2" target="step_user_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
